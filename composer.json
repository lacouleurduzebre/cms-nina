{
    "name": "nina/nina",
    "description": "A Symfony CMS - Content Management System / Système de gestion de contenu de site web sous Symfony",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "Nina",
        "CMS",
        "Symfony"
    ],
    "homepage": "https://www.cms-nina.fr",
    "authors": [
        {
            "name": "Nina Community - la couleur du Zèbre",
            "email": "contact@cms-nina.fr",
            "homepage": "https://www.cms-nina.fr"
        }
    ],
    "support": {
        "email": "contact@cms-nina.fr"
    },
    "require": {
        "php": ">=8.2",
        "ext-iconv": "*",
        "doctrine/annotations": "^1.0",
        "doctrine/dbal": "^3.7",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/doctrine-migrations-bundle": "^3.0",
        "doctrine/orm": "^2.20",
        "easycorp/easyadmin-bundle": "^4.0",
        "friendsofsymfony/jsrouting-bundle": "^3.0",
        "friendsofsymfony/user-bundle": "^3.4",
        "mpdf/mpdf": "^8.0",
        "php-translation/symfony-bundle": "^0.17",
        "phpdocumentor/reflection-docblock": "^5.2",
        "phpstan/phpdoc-parser": "^2.3",
        "psr/simple-cache": "^1.0",
        "symfony/apache-pack": "^1.0",
        "symfony/asset": "6.4.*",
        "symfony/console": "6.4.*",
        "symfony/expression-language": "6.4.*",
        "symfony/flex": "^1.21",
        "symfony/form": "6.4.*",
        "symfony/framework-bundle": "6.4.*",
        "symfony/mailer": "6.4.*",
        "symfony/mime": "6.4.*",
        "symfony/monolog-bundle": "^3.1",
        "symfony/process": "6.4.*",
        "symfony/property-access": "6.4.*",
        "symfony/property-info": "6.4.*",
        "symfony/security-bundle": "6.4.*",
        "symfony/serializer": "6.4.*",
        "symfony/validator": "6.4.*",
        "symfony/web-link": "6.4.*",
        "symfony/yaml": "6.4.*",
        "twig/extra-bundle": "^3.0",
        "twig/string-extra": "^3.0"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.0",
        "symfony/browser-kit": "6.4.*",
        "symfony/css-selector": "6.4.*",
        "symfony/debug-bundle": "6.4.*",
        "symfony/dotenv": "6.4.*",
        "symfony/maker-bundle": "^1.0",
        "symfony/phpunit-bridge": "6.4.*",
        "symfony/stopwatch": "6.4.*",
        "symfony/web-profiler-bundle": "6.4.*"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "composer/package-versions-deprecated": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Theme\\": "themes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install --symlink %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@php install.php",
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "id": "01C69V525Z6GW3M3F0WPAEA0AA",
            "allow-contrib": false,
            "require": "6.4.*"
        }
    }
}
