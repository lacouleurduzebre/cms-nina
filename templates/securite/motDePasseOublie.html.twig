{% extends "securite/layout.html.twig" %}

{% block contenu %}
    <form action="{{ path('mot_de_passe_oublie_envoi') }}" method="POST" class="fos_user_resetting_request mw960p center">
        <label for="username">{{ "Nom d'utilisateur ou adresse e-mail"|trans }}</label>
        <input type="text" id="username" name="username" required="required" />
