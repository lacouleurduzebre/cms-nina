{% extends "securite/layout.html.twig" %}

{% block contenu %}
    <div class="retourAccueil">
        <a href="
            {% if langues|length > 1 %}
                {{ path('accueilLocale', { '_locale': langueActive.abreviation }) }}
            {% else %}
                {{ path('accueil') }}
            {% endif %}
        ">
            <i class="fas fa-arrow-left"></i> {{ "Retour au site"|trans }}
        </a>
    </div>

    <div class="fos_user_user_show">
        <p>{{ "Nom d'utilisateur"|trans }} : {{ user.username }}</p>
        <p>{{ 'Adresse e-mail'|trans }} : {{ user.email }}</p>
    </div>
{% endblock contenu %}
