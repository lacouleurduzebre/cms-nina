{% extends 'back/base.html.twig' %}
{% if form is not empty %}
    {% form_theme form with 'back/form/theme.html.twig' %}
{% endif %}

{% block main %}
    <h1>{{ "Paramètres du thème"|trans }} "{{ nom }}"</h1>
    {% if form is not empty %}
        {{ form(form) }}
    {% else %}
        {{ "Ce thème n'est pas paramétrable"|trans }}
    {% endif %}
{% endblock %}