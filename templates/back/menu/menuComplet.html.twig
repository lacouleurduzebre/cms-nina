{# Menu du back-office (cf. App\Service\MenuAdmin), affiché dans la barre d'administration du front #}
{% macro render_menu_item(item) %}
    <a href="{{ item.url ?? '#' }}" {% if item.css_class is not empty %}class="{{ item.css_class }}"{% endif %}>
        {% if item.icon is not empty %}<i class="{{ item.icon }}"></i>{% endif %}
        <span>{{ item.label|trans }}</span>
        {% if item.enfants is not empty %}<i class="fas fa-angle-down mls"></i>{% endif %}
    </a>
{% endmacro %}

{% import _self as helper %}

<ul class="sidebar-menu">
    {% block main_menu %}
        {% for item in menuAdmin() %}
            <li class="{{ item.enfants is not empty ? 'treeview' }}">
                {{ helper.render_menu_item(item) }}

                {% if item.enfants is not empty %}
                    <ul class="treeview-menu">
                        {% for subitem in item.enfants %}
                            <li>
                                {{ helper.render_menu_item(subitem) }}

                                {% if subitem.enfants is not empty %}
                                    <ul class="treeview-menu">
                                        {% for subsubitem in subitem.enfants %}
                                            <li>{{ helper.render_menu_item(subsubitem) }}</li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </li>
        {% endfor %}
    {% endblock main_menu %}
    {% block header_custom_menu %}
        <li>
            {% set _logout_path = path('fos_user_security_logout') %}
            {% if app.user|default(false) == false %}
                <i class="hidden-xs fa fa-user-times"></i>
                {{ 'Anonyme'|trans }}
            {% elseif not _logout_path %}
                <i class="hidden-xs fa fa-user"></i>
                {{ app.user.username }}
            {% else %}
                <a href="#">
                    {% if app.user.imageProfil is not empty %}
                    <img id="header-imageProfil" src="{{ app.user.imageProfil }}" alt="{{ app.user.username }}">
                    {% else %}
                        <i id="header-sansImageProfil" class="fas fa-user-circle"></i>
                    {% endif %}
                    <span>{{ app.user.username }}</span>
                </a>
                <ul>
                    <li>
                        <a href="{{ admin_url('Utilisateur', 'edit', app.user.id) }}"><span>{% trans %}Mon profil{% endtrans %}</span></a>
                    </li>
                    <li>
                        <a href="{{ _logout_path }}"><span><i class="fas fa-power-off mrs"></i>{% trans %}Déconnexion{% endtrans %}</span></a>
                    </li>
                </ul>
            {% endif %}
        </li>
    {% endblock header_custom_menu %}
</ul>
{% if page.id is defined %}
    <a id="voirSite" href="{{ admin_url('Page_Active', 'edit', page.id) }}" title="{{ "Éditer cette page"|trans }}"><i class="fas fa-pencil-alt"></i></a>
{% else %}
    <a id="voirSite" href="
        {% if langues|length > 1 %}
            {{ path('accueilLocale', { '_locale': langueActive.abreviation }) }}
        {% else %}
            {{ path('accueil') }}
        {% endif %}
    " title="{% trans %}Voir le site{% endtrans %}"><i class="far fa-eye"></i></a>
{% endif %}

{% block main_menu_after %}{% endblock %}
